# ===== PostgreSQL 18 =====
POSTGRES_VERSION=18
CONTAINER_NAME=postgres18

# Kredensial superuser (GANTI sebelum produksi)
POSTGRES_USER=admin
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=appdb

# Jaringan: 0.0.0.0 = bisa diakses publik, 127.0.0.1 = hanya lokal
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5433

# /dev/shm container (naikkan jika pakai parallel query besar)
PG_SHM_SIZE=256mb

TZ=Asia/Jakarta

# User aplikasi (BUKAN superuser) - pakai ini di aplikasi Anda
APP_USER=app_user
APP_PASSWORD=ganti_dengan_password_kuat

# Nama host / IP untuk sertifikat SSL self-signed
SSL_CN=db.example.com

# ===== pgAdmin 4 (web UI) =====
PGADMIN_VERSION=latest
PGADMIN_CONTAINER_NAME=pgadmin

# Login pgAdmin (hanya dipakai saat volume pgAdmin pertama kali dibuat)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=ganti_dengan_password_kuat

# 127.0.0.1 = hanya lokal / SSH tunnel (disarankan), 0.0.0.0 = semua interface
PGADMIN_BIND_ADDRESS=127.0.0.1
PGADMIN_PORT=5050

# Akun dikunci setelah sekian kali gagal login
PGADMIN_MAX_LOGIN_ATTEMPTS=5
